// GENERATED from wrangler.template.jsonc by tooling/wire — edit the
// template, not this file. The committed copy is the fixture render
// (`pnpm run wire:fixture`); every Orun lane renders its own environment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "platforms-starter-kit-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // The tenant store: `subdomain:<name>` → { emoji, createdAt }, read and
  // written through lib/redis.ts (the Upstash client's surface over KV).
  // `wrangler dev` binds a local namespace whatever the id says.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000001"
    }
  ]
}
