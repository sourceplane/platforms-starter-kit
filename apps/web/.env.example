# Local development (`pnpm --filter @app/web dev`). Copy to .env.local
# (git-ignored). The root domain tenants hang off — `localhost:3000` when
# unset; browsers resolve <tenant>.localhost to the loopback address. On
# stage/prod the Orun build sets it from the environment's BASE_DOMAIN in
# intent.yaml (apps/web/component.yaml), and `next build` inlines it.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Optional: a Cloudflare Web Analytics beacon token (stands in for Vercel
# Speed Insights). Nothing is rendered while it is unset.
# NEXT_PUBLIC_CF_BEACON_TOKEN=
